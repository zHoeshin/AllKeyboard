<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="nn.zhoeshin.allkeyboard">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme">
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LayoutsListActivity"
            android:exported="true"
            android:theme="@style/Theme">
        </activity>
        <activity
            android:name=".ClipboardSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme">
        </activity>
        <activity
            android:name=".TimersSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme">
        </activity>
        <activity
            android:name=".CodeActivity"
            android:exported="true"
            android:theme="@style/Theme">
        </activity>
        <activity
            android:name=".SpecialLayoutsActivity"
            android:exported="true"
            android:theme="@style/Theme">
        </activity>


        <service
            android:name=".AllKeyboardService"
            android:exported="false"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:theme="@style/KeyboardTheme"
            tools:ignore="ExtraText">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>

</manifest>