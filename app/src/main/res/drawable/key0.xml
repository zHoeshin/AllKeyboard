<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="2dp">
    <selector>
        <item android:state_pressed="true">
            <shape>
                <solid android:color="#40ffffff" />
                <corners android:radius="8dp" />
            </shape>
        </item>
        <item>
            <shape>
                <solid android:color="#00ffffff" />
                <corners android:radius="8dp" />
            </shape>
        </item>
    </selector>
</inset>